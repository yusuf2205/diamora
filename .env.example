# Yusmus — environment template. On the NAS run `sh infra/scripts/nas-init.sh` to create .env with fresh random secrets.
# NEVER commit .env.

# ---- where data lives on the NAS (bind mounts; redundant storage + snapshots) ---------------------------------
DATA_ROOT=/data/production
BACKUP_ROOT=/data/backups

# ---- how phones reach the stack (docs/NAS-DEPLOYMENT.md §3; ports 80/443 belong to the NAS, D-025) ---------------
# ONE public origin for the API, Socket.IO and the web app, no trailing slash. Examples:
#   internet via Cloudflare Tunnel:  https://yusmus.example.uz
#   home Wi-Fi / first tests:        http://192.168.1.105:8088
PUBLIC_URL=http://192.168.1.105:8088
# The only published port (plain HTTP). 127.0.0.1 = NAS + tunnel only; 0.0.0.0 = also reachable from the home network.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# Optional internet HTTPS:  docker compose --profile tunnel up -d   (token from Cloudflare Zero Trust -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.8.3
CLOUDFLARED_MEM_LIMIT=128m
# Fixed Docker subnets so we never clash with the NAS's other projects or the home LAN
NET_EDGE_SUBNET=172.30.61.0/24
NET_DATA_SUBNET=172.30.62.0/24
NET_EGRESS_SUBNET=172.30.63.0/24

# ---- Telegram bot (owner action: @BotFather -> /newbot) -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE_ME

# ---- Yandex MapKit (ADMIN map, M4). Not used by the containers: it is passed to the Flutter build ---------------
#   flutter run|build --dart-define=YANDEX_MAPKIT_KEY=<this value>      (docs/YANDEX-MAPS.md)
YANDEX_MAPKIT_KEY=

# ---- Yandex Maps JS API (SUPER_ADMIN/ADMIN/MANAGER web map, M2 §20). A DIFFERENT product/key than the mobile
#   MapKit key above — Yandex Cloud issues "JavaScript API and Geocoder" keys separately. Optional: empty = the
#   web map page falls back to a real, fully working list view instead of a broken/blank map.
YANDEX_MAPS_JS_KEY=

# ---- PostgreSQL / Redis (internal network only) ----------------------------------------------------------------
POSTGRES_USER=yusmus
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=yusmus
BACKUP_DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
POSTGRES_MEM_LIMIT=1g
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=128mb
REDIS_MEM_LIMIT=256m

# ---- MinIO: files on the NAS -----------------------------------------------------------------------------------
MINIO_ROOT_USER=minio-root-CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=yusmus-app
S3_SECRET_KEY=CHANGE_ME
S3_BACKUP_ACCESS_KEY=yusmus-backup
S3_BACKUP_SECRET_KEY=CHANGE_ME
S3_BUCKET_PREFIX=
# hard quota per bucket (GiB, 0 = none) so MinIO can never fill the whole NAS unexpectedly
MINIO_BUCKET_QUOTA_GB=100
MINIO_CONSOLE_PORT=9001
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z.hotfix.7aa24e772
# MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# ---- application secrets ---------------------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME
FILE_SIGNING_SECRET=CHANGE_ME
LOG_LEVEL=info
SWAGGER_ENABLED=false

# ---- resource limits (defaults fit ~4 GB RAM) --------------------------------------------------------------------
API_MEM_LIMIT=512m
API_CPUS=1.5
WORKER_MEM_LIMIT=384m
WEB_MEM_LIMIT=384m
CADDY_MEM_LIMIT=128m
MINIO_MEM_LIMIT=512m
BACKUP_MEM_LIMIT=192m

# ---- backups (UTC cron; Tashkent = UTC+5) ------------------------------------------------------------------------
BACKUP_SCHEDULE_DUMP=0 21 * * *
BACKUP_SCHEDULE_CONFIG=45 21 * * *
BACKUP_SCHEDULE_MINIO=30 21 * * *
BACKUP_SCHEDULE_BASE=0 22 * * 0
BACKUP_SCHEDULE_VERIFY=30 22 * * *
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
BACKUP_RETENTION_BASE=3
# age PUBLIC key: keeps an ENCRYPTED copy of .env in the backups (`age-keygen`; store the private key offline)
BACKUP_AGE_RECIPIENT=

APP_VERSION=local

# ---- DEVELOPMENT without Docker: `pnpm dev:db` starts PostgreSQL 17; the API reads these directly -------------
# DATABASE_URL=postgresql://yusmus:yusmus_dev@127.0.0.1:54329/yusmus_dev?schema=public
# JWT_ACCESS_SECRET=dev-secret-dev-secret-dev-secret-123456
# FILE_SIGNING_SECRET=dev-file-secret-dev-file-secret-1234
# STORAGE_DRIVER=memory
