{
  "name": "@yusmus/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS: REST + WebSocket (dist/main.js) and the Telegram bot / outbox / maintenance process (dist/worker.js)",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "node ../../infra/scripts/with-env.mjs nest start --watch",
    "dev:worker": "node ../../infra/scripts/with-env.mjs nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand --forceExit",
    "cli:bootstrap": "node ../../infra/scripts/with-env.mjs node dist/cli/bootstrap.js",
    "cli:promote-owner": "node ../../infra/scripts/with-env.mjs node dist/cli/promote-owner.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^11.2.5",
    "@yusmus/database": "workspace:*",
    "@yusmus/shared": "workspace:*",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "~5.9.3"
  }
}
