{
  "name": "yusmus",
  "private": true,
  "version": "0.1.0",
  "description": "Home production: Telegram registration + Flutter (ADMIN/WORKER) + NAS + realtime",
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:db": "node infra/scripts/dev-postgres.mjs",
    "db:migrate:dev": "pnpm --filter @yusmus/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @yusmus/database migrate:deploy",
    "infra:lint": "node infra/scripts/lint-infra.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "prettier": "^3.6.2",
    "turbo": "^2.11.2",
    "typescript": "~5.9.3",
    "yaml": "^2.8.0"
  }
}
