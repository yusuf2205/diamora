{
  "name": "@yusmus/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations (incl. DB guards) and generated client. PostgreSQL on the NAS is the source of truth.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "prisma"],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "node ../../infra/scripts/with-env.mjs prisma migrate dev",
    "migrate:deploy": "node ../../infra/scripts/with-env.mjs prisma migrate deploy",
    "format": "prisma format"
  },
  "dependencies": { "@prisma/client": "^6.19.3", "prisma": "^6.19.3" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "~5.9.3" }
}
