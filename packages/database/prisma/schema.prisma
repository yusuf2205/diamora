// ------------------------------------------------------------------------------------------ platform

/// Outbox for Telegram messages + in-app notifications (D-006).
model Notification {
  id             String              @id @default(uuid(7)) @db.Uuid
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  workerId       String?             @db.Uuid
  telegramChatId BigInt?
  /// channel APP: the person who sees it in the app (bell + system notification)
  userId         String?             @db.Uuid
  /// channel APP: short headline; `body` is the detail line
  title          String?
  /// channel APP: where a tap leads inside the app, e.g. /admin/assignments/<id>
  link           String?
  /// channel APP: makes scheduled notices idempotent (one reminder per assignment/day, one summary per day, ...)
  dedupeKey      String?             @unique
  /// e.g. worker.approved, login_code
  type           String
  /// cleared after a successful send for sensitive messages (login codes)
  body           String?
  data           Json?
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now()) @db.Timestamptz(3)
  lastError      String?
  sentAt         DateTime?           @db.Timestamptz(3)
  readAt         DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([workerId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// IMMUTABLE.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @db.Uuid
  actorRole String?
  action    String
  entity    String
  entityId  String?  @db.Uuid
  before    Json?
  after     Json?
  ip        String?
  device    String?
  requestId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Metadata of an object in MinIO; bytes never live in PostgreSQL.
/// «Очистить журнал»: the journal shows only entries after the latest clear (the audit rows themselves are never deleted).
model AuditClear {
  id          String   @id @default(uuid(7)) @db.Uuid
  clearedById String   @db.Uuid
  clearedAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([clearedAt])
  @@map("audit_clears")
}

/// A signed-in device that gets instant notifications (Firebase Cloud Messaging token).
model PushToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("push_tokens")
}

enum ChatKind {
  DIRECT
  GROUP
  COMPANY
  CHANNEL
}

/// Who reads a channel: everyone, staff, workers - or only the members added by hand.
enum ChatAudience {
  ALL
  STAFF
  WORKERS
  CUSTOM
}

enum ChatMessageKind {
  TEXT
  IMAGE
  VIDEO
  VOICE
  AUDIO
  FILE
}

/// A conversation. DIRECT: exactly two people (directKey = the two user ids, sorted); GROUP: chosen members;
/// COMPANY: the one chat of everyone (every active user is a member).
model ChatRoom {
  id            String        @id @default(uuid(7)) @db.Uuid
  kind          ChatKind
  title         String?
  directKey     String?       @unique
  createdById   String?       @db.Uuid
  lastMessageAt DateTime?     @db.Timestamptz(3)
  /// the one message shown on top of the chat («Закреплённое сообщение»)
  pinnedMessageId String?     @db.Uuid
  description   String?
  photoFileId   String?       @db.Uuid
  /// channels: who reads it (members are joined automatically unless CUSTOM)
  audience      ChatAudience  @default(CUSTOM)
  /// groups: only the owner and group admins write (like a channel, but members still see each other)
  onlyAdminsWrite Boolean     @default(false)
  /// «Запретить копирование»: no copy / forward / save in the apps (a screenshot cannot be prevented)
  protectContent Boolean      @default(false)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  members       ChatMember[]
  messages      ChatMessage[]

  @@index([kind])
  @@map("chat_rooms")
}

model ChatMember {
  roomId     String    @db.Uuid
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOwner    Boolean   @default(false)
  /// a group / channel admin (manages members, writes in a channel)
  isAdmin    Boolean   @default(false)
  lastReadAt DateTime? @db.Timestamptz(3)
  joinedAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// this person keeps the chat on top of their list
  pinnedAt   DateTime? @db.Timestamptz(3)
  /// no push for this person until then (far future = muted for good)
  mutedUntil DateTime? @db.Timestamptz(3)
  /// «Очистить историю» for me: older messages are not shown to this person
  clearedAt  DateTime? @db.Timestamptz(3)
  /// «Удалить чат» (a direct chat) for me: hidden from my list until a new message arrives
  hiddenAt   DateTime? @db.Timestamptz(3)

  @@id([roomId, userId])
  @@index([userId])
  @@map("chat_members")
}

/// Text, or one file (photo/video/voice/audio/document) with an optional caption. Deleting keeps the row (deletedAt).
model ChatMessage {
  id         String          @id @default(uuid(7)) @db.Uuid
  roomId     String          @db.Uuid
  room       ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String?         @db.Uuid
  sender     User?           @relation("ChatSender", fields: [senderId], references: [id], onDelete: SetNull)
  kind       ChatMessageKind @default(TEXT)
  text       String?
  fileId     String?         @db.Uuid
  fileName   String?
  fileSize   BigInt?
  mimeType   String?
  durationMs Int?
  width      Int?
  height     Int?
  /// a video with a preview picture (FileAsset.thumbKey)
  hasThumb   Boolean         @default(false)
  /// a voice message's loudness, 48 values 0-31 as a comma list (drawn as bars)
  waveform   String?
  /// the sender's own id for this message: a retried send never posts it twice
  clientId   String?
  replyToId  String?         @db.Uuid
  replyTo    ChatMessage?    @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    ChatMessage[]   @relation("ChatReply")
  editedAt   DateTime?       @db.Timestamptz(3)
  /// «Переслано от …» (the original sender's name at the time)
  forwardedFrom String?
  reactions  ChatReaction[]
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime?       @db.Timestamptz(3)

  @@unique([senderId, clientId])
  @@index([roomId, createdAt])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin, map: "chat_messages_text_trgm")
  @@map("chat_messages")
}

/// One reaction per person per message (choosing another emoji replaces it).
model ChatReaction {
  messageId String      @db.Uuid
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@id([messageId, userId])
  @@map("chat_reactions")
}

model FileAsset {
  id           String   @id @default(uuid(7)) @db.Uuid
  bucket       String
  objectKey    String
  thumbKey     String?
  mimeType     String
  size         BigInt
  sha256       String
  width        Int?
  height       Int?
  originalName String?
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([bucket, objectKey])
  @@index([sha256])
  @@map("file_assets")
}

model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @db.Uuid
  key          String
  method       String
  path         String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model Sequence {
  key   String @id
  value Int    @default(0)

  @@map("sequences")
}
